@prefix phoa:  <http://example.org/phoa#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix schema:<https://schema.org/> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix time:  <http://www.w3.org/2006/time#> .
@prefix sosa:  <http://www.w3.org/ns/sosa/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .


phoa: a owl:Ontology ;
  rdfs:label "PhoA Ontology"@en ;
  rdfs:comment "Phobia-aware assistance ontology (users, phobias, triggers, context, interventions, devices, observations, alerts)."@en .

### CLASSES ###
phoa:User a owl:Class ;
  rdfs:subClassOf schema:Person ;
  rdfs:label "User"@en .

phoa:UserGroup a owl:Class ;
  rdfs:label "User Group"@en .

phoa:Phobia a owl:Class ;
  rdfs:subClassOf schema:MedicalCondition ;
  rdfs:label "Phobia"@en .

# (1) Reified link: a user's specific phobia instance (severity etc. are per-user and can change over time)
phoa:PhobiaAffliction a owl:Class ;
  rdfs:label "Phobia Affliction (per-user)"@en .

phoa:Trigger a owl:Class ;
  rdfs:label "Trigger"@en .

phoa:Context a owl:Class ;
  rdfs:label "Context / Situation"@en .

phoa:Season a owl:Class ;
  rdfs:subClassOf time:TemporalEntity ;
  rdfs:label "Season"@en .

phoa:Reaction a owl:Class ;
  rdfs:label "Reaction"@en .

phoa:Intervention a owl:Class ;
  rdfs:label "Intervention"@en .

# (2) Align intervention specializations with schema.org where helpful for interoperability
phoa:MedicationRecommendation a owl:Class ;
  rdfs:subClassOf phoa:Intervention, schema:Drug ;
  rdfs:label "Medication Recommendation"@en .

phoa:ExerciseRecommendation a owl:Class ;
  rdfs:subClassOf phoa:Intervention, schema:ExercisePlan ;
  rdfs:label "Exercise Recommendation"@en .

phoa:SeriousGameRecommendation a owl:Class ;
  rdfs:subClassOf phoa:Intervention, schema:SoftwareApplication ;
  rdfs:label "Serious Game Recommendation"@en .

phoa:WebResourceRecommendation a owl:Class ;
  rdfs:subClassOf phoa:Intervention, schema:WebPage ;
  rdfs:label "Web Resource Recommendation"@en .

phoa:Notification a owl:Class ;
  rdfs:label "Notification / Alert"@en .

phoa:DataSource a owl:Class ;
  rdfs:label "Data Source"@en .

phoa:Device a owl:Class ;
  rdfs:label "Device"@en .

phoa:altitudeMeters a rdf:Property ;
  rdfs:label "Altitude (meters)"@en .

phoa:noiseLevelDb a rdf:Property ;
  rdfs:label "Noise level (dB)"@en .

phoa:fearRating a rdf:Property ;
  rdfs:label "Fear rating (0-10)"@en .

phoa:addressed a rdf:Property ;
  rdfs:domain phoa:Context ;
  rdfs:range xsd:boolean ;
  rdfs:label "addressed"@en .

phoa:heartRateBpm a sosa:ObservableProperty ;
  rdfs:label "Heart rate (bpm)"@en .

### OBJECT PROPERTIES ###
phoa:hasPhobia a owl:ObjectProperty ;
  rdfs:domain phoa:User ;
  rdfs:range phoa:Phobia ;
  rdfs:label "has phobia (shortcut)"@en ;
  rdfs:comment "Convenience link. Use PhobiaAffliction for per-user details like severity."@en .

phoa:hasPhobiaAffliction a owl:ObjectProperty ;
  rdfs:domain phoa:User ;
  rdfs:range phoa:PhobiaAffliction ;
  rdfs:label "has phobia affliction"@en .

phoa:phobiaType a owl:ObjectProperty ;
  rdfs:domain phoa:PhobiaAffliction ;
  rdfs:range phoa:Phobia ;
  rdfs:label "phobia type"@en .

phoa:memberOfGroup a owl:ObjectProperty ;
  rdfs:domain phoa:User ;
  rdfs:range phoa:UserGroup ;
  rdfs:label "member of group"@en .

phoa:hasTrigger a owl:ObjectProperty ;
  rdfs:domain phoa:Phobia ;
  rdfs:range phoa:Trigger ;
  rdfs:label "has trigger"@en .

phoa:hasContext a owl:ObjectProperty ;
  rdfs:domain phoa:User ;
  rdfs:range phoa:Context ;
  rdfs:label "has context"@en .

# (3) Context details: location + time/season/event (query-friendly)
phoa:contextLocation a owl:ObjectProperty ;
  rdfs:domain phoa:Context ;
  rdfs:range schema:Place ;
  rdfs:label "context location"@en .

phoa:contextSeason a owl:ObjectProperty ;
  rdfs:domain phoa:Context ;
  rdfs:range phoa:Season ;
  rdfs:label "context season"@en .

phoa:contextEvent a owl:ObjectProperty ;
  rdfs:domain phoa:Context ;
  rdfs:range schema:Event ;
  rdfs:label "context event"@en .

phoa:contextTime a owl:ObjectProperty ;
  rdfs:domain phoa:Context ;
  rdfs:range time:TemporalEntity ;
  rdfs:label "context time"@en .

phoa:recommendedIntervention a owl:ObjectProperty ;
  rdfs:domain phoa:Phobia ;
  rdfs:range phoa:Intervention ;
  rdfs:label "recommended intervention"@en .

phoa:targetsPhobia a owl:ObjectProperty ;
  rdfs:domain phoa:Intervention ;
  rdfs:range phoa:Phobia ;
  rdfs:label "targets phobia"@en .

phoa:notifiedUser a owl:ObjectProperty ;
  rdfs:domain phoa:Notification ;
  rdfs:range phoa:User ;
  rdfs:label "notified user"@en .

phoa:deliveredIntervention a owl:ObjectProperty ;
  rdfs:domain phoa:Notification ;
  rdfs:range phoa:Intervention ;
  rdfs:label "delivered intervention"@en .

phoa:notificationContext a owl:ObjectProperty ;
  rdfs:domain phoa:Notification ;
  rdfs:range phoa:Context ;
  rdfs:label "notification context"@en .

phoa:reportedBy a owl:ObjectProperty ;
  rdfs:domain phoa:Context ;
  rdfs:range phoa:DataSource ;
  rdfs:label "reported by"@en .

phoa:usesDevice a owl:ObjectProperty ;
  rdfs:domain phoa:User ;
  rdfs:range phoa:Device ;
  rdfs:label "uses device"@en .

# (4) Observations (sensor/API signals) using SOSA
phoa:hasObservation a owl:ObjectProperty ;
  rdfs:domain phoa:User ;
  rdfs:range sosa:Observation ;
  rdfs:label "has observation"@en .

phoa:hasEntourageContact a owl:ObjectProperty ;
  rdfs:label "has entourage contact"@en ;
  rdfs:comment "Links a user to a trusted contact (family, friend, coworker, doctor) who may receive alerts or provide input."@en ;
  rdfs:domain phoa:User ;
  rdfs:range foaf:Person .

### DATA PROPERTIES ###
# (1) Severity is per-user (on PhobiaAffliction), not on the general Phobia concept.
phoa:severity a owl:DatatypeProperty ;
  rdfs:domain phoa:PhobiaAffliction ;
  rdfs:range xsd:integer ;
  rdfs:label "severity (1-10)"@en .

phoa:confidence a owl:DatatypeProperty ;
  rdfs:domain phoa:Notification ;
  rdfs:range xsd:decimal ;
  rdfs:label "confidence"@en .

# Optional: affliction time bounds (useful for longitudinal tracking)
phoa:afflictionStart a owl:DatatypeProperty ;
  rdfs:domain phoa:PhobiaAffliction ;
  rdfs:range xsd:dateTime ;
  rdfs:label "affliction start"@en .

phoa:afflictionEnd a owl:DatatypeProperty ;
  rdfs:domain phoa:PhobiaAffliction ;
  rdfs:range xsd:dateTime ;
  rdfs:label "affliction end"@en .

phoa:status a owl:DatatypeProperty ;
  rdfs:domain phoa:Notification ;
  rdfs:range xsd:string ;
  rdfs:label "status"@en .

phoa:ackTime a owl:DatatypeProperty ;
  rdfs:domain phoa:Notification ;
  rdfs:range xsd:dateTime ;
  rdfs:label "ack time"@en .

phoa:relationship a owl:DatatypeProperty ;
  rdfs:label "relationship"@en ;
  rdfs:comment "Relationship type between the user and the contact (e.g., Family, Friend, Professional)."@en ;
  rdfs:domain foaf:Person ;
  rdfs:range xsd:string .

phoa:alertsEnabled a owl:DatatypeProperty ;
  rdfs:label "alerts enabled"@en ;
  rdfs:comment "Whether this contact should receive alerts for the user."@en ;
  rdfs:domain foaf:Person ;
  rdfs:range xsd:boolean .

phoa:youtubeLink a owl:DatatypeProperty ;
  rdfs:label "YouTube link"@en ;
  rdfs:domain phoa:ExerciseRecommendation ;
  rdfs:range  xsd:anyURI ;
  rdfs:subPropertyOf schema:url .

### MAPPING PROPERTY (for KB links) ###
phoa:exactMatch a owl:AnnotationProperty ;
  rdfs:subPropertyOf skos:exactMatch ;
  rdfs:label "exact match to external KB"@en .


#################################################################
### INDIVIDUALS (example ABox) ###
#################################################################

phoa:Alice a phoa:User ;
  schema:name "Alice" ;
  phoa:hasPhobia phoa:Claustrophobia ;
  phoa:hasPhobia phoa:Acrophobia ;
  phoa:hasAllergy phoa:PollenAllergy ;
  phoa:hasPhobiaAffliction phoa:AliceClaustrophobiaAffliction ;
  phoa:hasPhobiaAffliction phoa:AliceAcrophobiaAffliction ;
  phoa:hasPhobiaAffliction phoa:AliceArachnophobiaAffliction ;
  phoa:hasPhobiaAffliction phoa:AliceAgoraphobiaAffliction ;
  phoa:usesDevice phoa:AppleWatch ;
  phoa:hasContext phoa:CurrentContext1 ;
  phoa:hasObservation phoa:Obs1 ;
  phoa:hasContext phoa:CurrentContext_Heights1 ;
  phoa:hasContext phoa:CurrentContext_Spider1 ;
  phoa:hasContext phoa:CurrentContext_Crowd1 ;
  phoa:hasObservation phoa:Obs_Heights_HeartRate1 ;
  phoa:hasObservation phoa:Obs_Heights_Altitude1 ;
  phoa:hasObservation phoa:Obs_Heights_FearRating1 ;
  phoa:hasObservation phoa:Obs_Spider_HeartRate1 ;
  phoa:hasObservation phoa:Obs_Spider_FearRating1 ;
  phoa:hasObservation phoa:Obs_Crowd_HeartRate1 ;
  phoa:hasObservation phoa:Obs_Crowd_NoiseLevel1 ;
  phoa:hasObservation phoa:Obs_Crowd_FearRating1 .

phoa:AppleWatch a phoa:Device ;
  rdfs:label "Apple Watch"@en .

# Per-user affliction details (severity etc.)
phoa:AliceClaustrophobiaAffliction a phoa:PhobiaAffliction ;
  phoa:phobiaType phoa:Claustrophobia ;
  phoa:severity 7 ;
  phoa:afflictionStart "2025-10-01T00:00:00Z"^^xsd:dateTime .

phoa:AliceAcrophobiaAffliction a phoa:PhobiaAffliction ;
  phoa:phobiaType phoa:Acrophobia ;
  phoa:severity 5 ;
  phoa:afflictionStart "2025-11-15T00:00:00Z"^^xsd:dateTime .

phoa:Claustrophobia a phoa:Phobia ;
  rdfs:label "Claustrophobia"@en ;
  phoa:hasTrigger phoa:SmallEnclosedSpace ;
  phoa:recommendedIntervention phoa:BreathingExercise ,
                                 phoa:ExposureSteps ,
                                 phoa:VRETcity ,
                                 phoa:NHSPhobiasSelfHelp ,
                                 phoa:NHSInformPhobiasGuide ;
  phoa:exactMatch <http://dbpedia.org/resource/Claustrophobia> ;
  skos:exactMatch <http://www.wikidata.org/entity/Q186892> .

###################################################

phoa:Acrophobia a phoa:Phobia ;
  rdfs:label "Acrophobia"@en ;
  phoa:hasTrigger phoa:HighAltitude ;
  phoa:recommendedIntervention phoa:GroundingExercise ,
                                 phoa:ExposureSteps ,
                                 phoa:ZeroPhobiaHeights ,
                                 phoa:VRETcity ,
                                 phoa:Propranolol ,
                                 phoa:NHSPhobiasSelfHelp ,
                                 phoa:NHSInformPhobiasGuide ;
  skos:exactMatch <http://dbpedia.org/resource/Acrophobia> ;
  skos:exactMatch <http://www.wikidata.org/entity/Q207783> .

phoa:CurrentContext_Heights1 a phoa:Context ;
  phoa:contextEvent phoa:OnBalconyEvent ;
  phoa:contextLocation phoa:OfficeBalcony ;
  phoa:contextTime phoa:InstantHeights1 .

phoa:InstantHeights1 a time:Instant ;
  time:inXSDDateTime "2026-01-05T10:30:00Z"^^xsd:dateTime .

phoa:OnBalconyEvent a schema:Event ;
  schema:name "On balcony"@en .

phoa:OfficeBalcony a schema:Place ;
  schema:name "Office balcony (floor 10)"@en ;
  schema:geo [
    a schema:GeoCoordinates ;
    schema:latitude 44.4268 ;
    schema:longitude 26.1025
  ] .

###################################################

phoa:Arachnophobia a phoa:Phobia ;
  rdfs:label "Arachnophobia"@en ;
  phoa:hasTrigger phoa:Spider ;
  phoa:recommendedIntervention phoa:BreathingExercise ,
                                 phoa:CognitiveReframing ,
                                 phoa:ZeroPhobiaSpiders ,
                                 phoa:PhobysSpiders ,
                                 phoa:Propranolol ,
                                 phoa:NHSPhobiasSelfHelp ,
                                 phoa:NHSInformPhobiasGuide ;
  skos:exactMatch <http://dbpedia.org/resource/Arachnophobia> ;
  skos:exactMatch <http://www.wikidata.org/entity/Q220783> .

phoa:CurrentContext_Spider1 a phoa:Context ;
  phoa:contextEvent phoa:InBasementEvent ;
  phoa:contextLocation phoa:HomeBasement ;
  phoa:contextTime phoa:InstantSpider1 .

phoa:InstantSpider1 a time:Instant ;
  time:inXSDDateTime "2026-01-06T19:10:00Z"^^xsd:dateTime .

phoa:InBasementEvent a schema:Event ;
  schema:name "In basement"@en .

phoa:HomeBasement a schema:Place ;
  schema:name "Home basement"@en .

###################################################


phoa:Agoraphobia a phoa:Phobia ;
  rdfs:label "Agoraphobia"@en ;
  phoa:hasTrigger phoa:CrowdedPlace ;
  phoa:recommendedIntervention phoa:ExposureSteps ,
                                 phoa:SafePlacePlanning ,
                                 phoa:Sertraline ,
                                 phoa:Escitalopram ,
                                 phoa:VRETcity ,
                                 phoa:NHSTreatmentAgoraphobia ,
                                 phoa:NHSPhobiasSelfHelp ,
                                 phoa:NHSInformPhobiasGuide ;
  skos:exactMatch <http://dbpedia.org/resource/Agoraphobia> ;
  skos:exactMatch <http://www.wikidata.org/entity/Q174589> .

phoa:CurrentContext_Crowd1 a phoa:Context ;
  phoa:contextEvent phoa:InMallCrowdEvent ;
  phoa:contextLocation phoa:CityMall ;
  phoa:contextTime phoa:InstantCrowd1 .

phoa:InstantCrowd1 a time:Instant ;
  time:inXSDDateTime "2026-01-07T17:45:00Z"^^xsd:dateTime .

phoa:InMallCrowdEvent a schema:Event ;
  schema:name "In shopping mall (crowded)"@en .

phoa:CityMall a schema:Place ;
  schema:name "City mall"@en ;
  schema:geo [
    a schema:GeoCoordinates ;
    schema:latitude 44.4350 ;
    schema:longitude 26.1030
  ] .

##########################################################

phoa:AliceArachnophobiaAffliction a phoa:PhobiaAffliction ;
  phoa:phobiaType phoa:Arachnophobia ;
  phoa:severity 6 ;
  phoa:afflictionStart "2025-09-10T00:00:00Z"^^xsd:dateTime .

phoa:AliceAgoraphobiaAffliction a phoa:PhobiaAffliction ;
  phoa:phobiaType phoa:Agoraphobia ;
  phoa:severity 4 ;
  phoa:afflictionStart "2025-08-20T00:00:00Z"^^xsd:dateTime .

phoa:PollenAllergy a phoa:Allergy ;
  rdfs:label "Pollen allergy"@en ;
  skos:exactMatch <http://dbpedia.org/resource/Allergy> ;
  skos:exactMatch <http://www.wikidata.org/entity/Q128581> .



phoa:SmallEnclosedSpace a phoa:Trigger ;
  rdfs:label "Small enclosed space"@en .


phoa:HighAltitude a phoa:Trigger .
phoa:Spider a phoa:Trigger .
phoa:CrowdedPlace a phoa:Trigger .
phoa:SmallEnclosedSpace a phoa:Trigger .


# Context example: Alice is currently in an elevator (place with geo) at a specific time
phoa:CurrentContext1 a phoa:Context ;
  phoa:contextEvent phoa:InElevatorEvent ;
  phoa:contextLocation phoa:OfficeElevator ;
  phoa:contextTime phoa:InstantNow .

phoa:InstantNow a time:Instant ;
  time:inXSDDateTime "2026-01-05T09:00:00Z"^^xsd:dateTime .

phoa:InElevatorEvent a schema:Event ;
  schema:name "In elevator"@en .

phoa:OfficeElevator a schema:Place ;
  schema:name "Office elevator"@en ;
  schema:geo [
    a schema:GeoCoordinates ;
    schema:latitude 44.4268 ;
    schema:longitude 26.1025
  ] .

# Interventions
phoa:BreathingExercise a phoa:ExerciseRecommendation ;
  rdfs:label "Box breathing (4-4-4-4)"@en ;
  phoa:targetsPhobia phoa:Claustrophobia, phoa:Arachnophobia, phoa:Agoraphobia, phoa:Acrophobia ;
  phoa:youtubeLink "https://www.youtube.com/watch?v=aPYmZOhJF5Q"^^xsd:anyURI .

phoa:ExposureSteps a phoa:ExerciseRecommendation ;
  rdfs:label "Gradual exposure ladder for enclosed spaces"@en ;
  phoa:targetsPhobia phoa:Claustrophobia, phoa:Arachnophobia, phoa:Agoraphobia, phoa:Acrophobia ;
  phoa:youtubeLink "https://www.youtube.com/watch?v=n2rKVj75P3M"^^xsd:anyURI .

phoa:GroundingExercise a phoa:ExerciseRecommendation ;
  rdfs:label "5-4-3-2-1 grounding exercise"@en ;
  phoa:targetsPhobia phoa:Claustrophobia, phoa:Arachnophobia, phoa:Agoraphobia, phoa:Acrophobia ;
  phoa:youtubeLink "https://www.youtube.com/watch?v=30VMIEmA114"^^xsd:anyURI .

phoa:CognitiveReframing a phoa:ExerciseRecommendation ;
  rdfs:label "Cognitive reframing (challenge anxious thoughts)"@en ;
  phoa:targetsPhobia phoa:Claustrophobia, phoa:Arachnophobia, phoa:Agoraphobia, phoa:Acrophobia ;
  phoa:youtubeLink "https://www.youtube.com/watch?v=tfkhkFwCtxs"^^xsd:anyURI .

phoa:SafePlacePlanning a phoa:ExerciseRecommendation ;
  rdfs:label "Safe-place planning (exit routes + coping plan)"@en ;
  phoa:targetsPhobia phoa:Claustrophobia, phoa:Agoraphobia, phoa:Acrophobia ;
  phoa:youtubeLink "https://www.youtube.com/watch?v=JA86YOd4zx4"^^xsd:anyURI .


###########
# MedicationRecommendation (schema:Drug)
###########

phoa:Sertraline a phoa:MedicationRecommendation ;
  rdfs:label "Sertraline (SSRI)"@en ;
  schema:activeIngredient "sertraline" ;
  schema:dosageForm "tablet" ;
  phoa:targetsPhobia phoa:Agoraphobia .

phoa:Escitalopram a phoa:MedicationRecommendation ;
  rdfs:label "Escitalopram (SSRI)"@en ;
  schema:activeIngredient "escitalopram" ;
  schema:dosageForm "tablet" ;
  phoa:targetsPhobia phoa:Agoraphobia .

phoa:Propranolol a phoa:MedicationRecommendation ;
  rdfs:label "Propranolol (beta-blocker; situational physical symptoms)"@en ;
  schema:activeIngredient "propranolol" ;
  schema:dosageForm "tablet" ;
  phoa:targetsPhobia phoa:Acrophobia, phoa:Arachnophobia .

###########
# SeriousGameRecommendation (schema:SoftwareApplication)
###########

phoa:ZeroPhobiaHeights a phoa:SeriousGameRecommendation ;
  rdfs:label "ZeroPhobia: Fear of Heights (VR)"@en ;
  schema:applicationCategory "HealthApplication" ;
  schema:url "https://play.google.com/store/apps/details?hl=en&id=com.insession.zero_phobia"^^xsd:anyURI ;
  phoa:targetsPhobia phoa:Acrophobia .

phoa:ZeroPhobiaSpiders a phoa:SeriousGameRecommendation ;
  rdfs:label "ZeroPhobia: Fear of Spiders (AR)"@en ;
  schema:applicationCategory "HealthApplication" ;
  schema:url "https://play.google.com/store/apps/details?hl=en&id=com.insession.spinnenangst"^^xsd:anyURI ;
  phoa:targetsPhobia phoa:Arachnophobia .

phoa:PhobysSpiders a phoa:SeriousGameRecommendation ;
  rdfs:label "Phobys (AR exposure training for fear of spiders)"@en ;
  schema:applicationCategory "HealthApplication" ;
  schema:url "https://mcn.unibas.ch/de/publications/mobile-apps/phobys/"^^xsd:anyURI ;
  phoa:targetsPhobia phoa:Arachnophobia .

phoa:VRETcity a phoa:SeriousGameRecommendation ;
  rdfs:label "VRETcity (VR exposure city)"@en ;
  schema:applicationCategory "HealthApplication" ;
  schema:url "https://vretcity.com/en"^^xsd:anyURI ;
  phoa:targetsPhobia phoa:Acrophobia, phoa:Claustrophobia, phoa:Agoraphobia .

###########
# WebResourceRecommendation (schema:WebPage)
###########

phoa:NHSPhobiasSelfHelp a phoa:WebResourceRecommendation ;
  rdfs:label "NHS: Self-help for phobias"@en ;
  schema:url "https://www.nhs.uk/mental-health/conditions/phobias/self-help/"^^xsd:anyURI ;
  phoa:targetsPhobia phoa:Claustrophobia, phoa:Arachnophobia, phoa:Agoraphobia, phoa:Acrophobia .

phoa:NHSInformPhobiasGuide a phoa:WebResourceRecommendation ;
  rdfs:label "NHS Inform: Phobias self-help guide"@en ;
  schema:url "https://www.nhsinform.scot/illnesses-and-conditions/mental-health/mental-health-self-help-guides/phobias-self-help-guide/"^^xsd:anyURI ;
  phoa:targetsPhobia phoa:Claustrophobia, phoa:Arachnophobia, phoa:Agoraphobia, phoa:Acrophobia .

phoa:NHSTreatmentAgoraphobia a phoa:WebResourceRecommendation ;
  rdfs:label "NHS: Treatment for agoraphobia"@en ;
  schema:url "https://www.nhs.uk/mental-health/conditions/agoraphobia/treatment/"^^xsd:anyURI ;
  phoa:targetsPhobia phoa:Agoraphobia .



# Sensor observation example (SOSA): elevated heart rate detected by watch
phoa:AppleWatchHeartRateSensor a sosa:Sensor ;
  rdfs:label "Apple Watch heart-rate sensor"@en .

phoa:PhoneBarometer a sosa:Sensor ;
  rdfs:label "Phone barometer"@en .

phoa:PhoneMicrophone a sosa:Sensor ;
  rdfs:label "Phone microphone"@en .

phoa:SelfReportInput a sosa:Sensor ;
  rdfs:label "In-app self report"@en .



phoa:Obs1 a sosa:Observation ;
  sosa:madeBySensor phoa:AppleWatchHeartRateSensor ;
  sosa:observedProperty phoa:heartRateBpm ;
  sosa:hasSimpleResult 112 ;
  sosa:resultTime "2026-01-05T09:00:10Z"^^xsd:dateTime .


############################
# Acrophobia-related observations
############################
phoa:Obs_Heights_HeartRate1 a sosa:Observation ;
  sosa:madeBySensor phoa:AppleWatchHeartRateSensor ;
  sosa:observedProperty phoa:heartRateBpm ;
  sosa:hasSimpleResult 126 ;
  sosa:resultTime "2026-01-05T10:30:20Z"^^xsd:dateTime .

phoa:Obs_Heights_Altitude1 a sosa:Observation ;
  sosa:madeBySensor phoa:PhoneBarometer ;
  sosa:observedProperty phoa:altitudeMeters ;
  sosa:hasSimpleResult 32 ;
  sosa:resultTime "2026-01-05T10:30:05Z"^^xsd:dateTime .

phoa:Obs_Heights_FearRating1 a sosa:Observation ;
  sosa:madeBySensor phoa:SelfReportInput ;
  sosa:observedProperty phoa:fearRating ;
  sosa:hasSimpleResult 8 ;
  sosa:resultTime "2026-01-05T10:30:25Z"^^xsd:dateTime .


############################
# Arachnophobia-related observations
############################
phoa:Obs_Spider_HeartRate1 a sosa:Observation ;
  sosa:madeBySensor phoa:AppleWatchHeartRateSensor ;
  sosa:observedProperty phoa:heartRateBpm ;
  sosa:hasSimpleResult 118 ;
  sosa:resultTime "2026-01-06T19:10:15Z"^^xsd:dateTime .

phoa:Obs_Spider_FearRating1 a sosa:Observation ;
  sosa:madeBySensor phoa:SelfReportInput ;
  sosa:observedProperty phoa:fearRating ;
  sosa:hasSimpleResult 9 ;
  sosa:resultTime "2026-01-06T19:10:30Z"^^xsd:dateTime .


############################
# Agoraphobia-related observations
############################
phoa:Obs_Crowd_HeartRate1 a sosa:Observation ;
  sosa:madeBySensor phoa:AppleWatchHeartRateSensor ;
  sosa:observedProperty phoa:heartRateBpm ;
